NODE_ENV=development
PORT=5000

# Local dev:   http://localhost:5173
# Production:  https://pos-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# Local: mongodb://127.0.0.1:27017/pos
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pos?retryWrites=true&w=majority
MONGO_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# false for local dev (HTTP), true for production (HTTPS)
COOKIE_SECURE=false

# Optional: AI key can also be set via Admin → Settings page in the UI (stored in MongoDB)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

STORE_NAME=POS Retail Store
