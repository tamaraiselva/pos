NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Local: mongodb://127.0.0.1:27017/pos?replicaSet=rs0  (requires a single-node replica set, see README)
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pos?retryWrites=true&w=majority
MONGO_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

STORE_NAME=POS Retail Store
